# ---------------------------------------------------------------------------
# QueueSense environment configuration. Copy to `.env` and fill in values.
# The server validates these at startup and refuses to boot if they are invalid.
# ---------------------------------------------------------------------------

# NODE_ENV is set by the npm scripts (dev / build / start); don't set it here.

# HTTP port for the API + web app.
PORT=3000

# MySQL 8 connection URL (URL-encode special characters in the password, e.g. @ -> %40).
DATABASE_URL=mysql://queuesense:change-me@127.0.0.1:3306/queuesense

# Separate database used by `pnpm test` integration tests. It is wiped by the tests.
TEST_DATABASE_URL=mysql://queuesense:change-me@127.0.0.1:3306/queuesense_test

# At least 32 random characters. Used to HMAC session tokens and activation codes.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-at-least-32-random-characters

# Public origin of the web app. Required in production: used for CSRF origin checks.
APP_ORIGIN=http://localhost:3000

# IANA time zone used for daily token numbering (A001 resets each campus day).
CAMPUS_TIMEZONE=Asia/Kolkata

# Optional
# SESSION_TTL_HOURS=168
# TRUST_PROXY=1            # set when running behind a reverse proxy / load balancer
# LOG_LEVEL=info           # debug | info | warn | error
