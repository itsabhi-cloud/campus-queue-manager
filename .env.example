# ---------------------------------------------------------------------------
# QueueSense environment configuration. Copy to `.env` for development.
# The server validates these at startup and refuses to boot if they are invalid.
# NODE_ENV is set by the npm scripts (dev / build / start); don't set it here.
# ---------------------------------------------------------------------------

# HTTP port for the API, realtime stream and web app (one process serves all three).
PORT=3000

# MySQL 8.0.16+ connection URL (URL-encode special characters in the password, e.g. @ -> %40).
DATABASE_URL=mysql://queuesense:change-me@127.0.0.1:3306/queuesense

# Separate database used by `pnpm test`. Its name MUST end in _test; the tests wipe it.
TEST_DATABASE_URL=mysql://queuesense:change-me@127.0.0.1:3306/queuesense_test

# At least 32 random characters. HMAC key for session tokens and activation codes.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it signs everyone out and invalidates unused activation codes.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Public origin of the app. In production it must be https:// and not localhost
# (used for the CSRF origin check; cookies are Secure in production).
APP_ORIGIN=http://localhost:3000

# IANA time zone used for daily token numbering (tokens restart at 001 each campus day).
CAMPUS_TIMEZONE=Asia/Kolkata

# ---- Optional ----------------------------------------------------------------
# SESSION_TTL_HOURS=168            # session lifetime (1–2160)
# TRUST_PROXY=1                    # set behind a reverse proxy / load balancer so client IPs are real
# LOG_LEVEL=info                   # debug | info | warn | error
# MIGRATIONS_DIR=drizzle/migrations # where `node dist/migrate.js` looks (relative to the working directory)
# ALLOW_INSECURE_ORIGIN=true       # ONLY to run a production build on your own machine over http://localhost

# ---- Managed MySQL over TLS (optional) ------------------------------------------
# DB_SSL=true connects over TLS and verifies the server certificate, including that it was issued
# for the DATABASE_URL host. Without DB_SSL_CA the certificate must chain to a public CA.
# DB_SSL=true
# DB_SSL_CA is the PEM text of the provider's CA certificate (Aiven: "CA certificate" on the
# service page). Multi-line values work; on one line, write line breaks as \n.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Not used: there is no email provider, CORS allow-list or external notification service.
# The API only serves its own origin; realtime uses Server-Sent Events on the same origin.
